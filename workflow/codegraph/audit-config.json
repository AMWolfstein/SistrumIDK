{
  "languages": {
    "kotlin": {
      "extensions": [
        ".kt"
      ],
      "tests": [
        "*/src/test/*",
        "*/src/androidTest/*",
        "*/src/testDev/*",
        "*/src/testQa/*",
        "*/src/testDevQa/*",
        "*/src/androidTestDev/*",
        "*/src/androidTestQa/*",
        "*/src/androidTestDevQa/*",
        "*/src/commonTest/*",
        "*/src/androidHostTest/*",
        "*/src/androidDeviceTest/*"
      ]
    },
    "python": {
      "extensions": [
        ".py"
      ],
      "tests": [
        "*/test_*.py",
        "*/tests/*"
      ]
    },
    "shell": {
      "extensions": [
        ".sh",
        ".bash"
      ],
      "tests": []
    },
    "cpp": {
      "extensions": [
        ".cpp",
        ".cc",
        ".c",
        ".h",
        ".hpp",
        ".cxx"
      ],
      "tests": [
        "tests/*",
        "*/tests/*",
        "*_test.cpp",
        "test_*.cpp"
      ]
    },
    "java": {
      "extensions": [
        ".java"
      ],
      "tests": [
        "*/src/test/*",
        "*/src/androidTest/*",
        "*/src/testDev/*",
        "*/src/testQa/*",
        "*/src/testDevQa/*",
        "*/src/androidTestDev/*",
        "*/src/androidTestQa/*",
        "*/src/androidTestDevQa/*",
        "*/src/commonTest/*",
        "*/src/androidHostTest/*",
        "*/src/androidDeviceTest/*"
      ]
    }
  },
  "protected": [
    "third_party/*",
    "workflow/codegraph/fixtures/*"
  ],
  "categories": {
    "dead-code": {
      "kotlin": [
        "ObsoleteSdkInt",
        "UnusedResources",
        "UnusedIds"
      ],
      "java": [
        "ObsoleteSdkInt",
        "UnusedResources",
        "UnusedIds"
      ],
      "cpp": [
        "clang-diagnostic-unused-*",
        "clang-diagnostic-unreachable-code*",
        "clang-analyzer-deadcode.*",
        "misc-unused-*"
      ],
      "python": [
        "F401",
        "F811",
        "F841",
        "F822",
        "F823"
      ],
      "shell": [
        "SC2034",
        "SC2317"
      ]
    },
    "optimization": {
      "kotlin": [
        "DrawAllocation",
        "UseSparseArrays",
        "UseValueOf"
      ],
      "java": [
        "DrawAllocation",
        "UseSparseArrays",
        "UseValueOf"
      ],
      "cpp": [
        "performance-*"
      ]
    },
    "simplifier": {
      "kotlin": [
        "ObsoleteSdkInt",
        "UseKtx",
        "ReplaceStringBuilder"
      ],
      "java": [
        "ObsoleteSdkInt",
        "UseKtx",
        "ReplaceStringBuilder"
      ],
      "cpp": [
        "readability-redundant-*",
        "readability-container-size-empty",
        "modernize-use-nullptr",
        "modernize-use-equals-default"
      ],
      "python": [
        "SIM*",
        "C4*",
        "PIE*"
      ],
      "shell": [
        "SC2001",
        "SC2002",
        "SC2015",
        "SC2162",
        "SC2181"
      ]
    },
    "bugs": {
      "kotlin": [
        "NewApi",
        "Recycle",
        "StaticFieldLeak",
        "HandlerLeak",
        "MissingSuperCall",
        "WrongConstant",
        "CommitPrefEdits",
        "ApplySharedPref",
        "ObsoleteSdkInt"
      ],
      "java": [
        "NewApi",
        "Recycle",
        "StaticFieldLeak",
        "HandlerLeak",
        "MissingSuperCall",
        "WrongConstant",
        "CommitPrefEdits",
        "ApplySharedPref",
        "ObsoleteSdkInt"
      ],
      "cpp": [
        "clang-analyzer-core.*",
        "clang-analyzer-unix.*",
        "clang-analyzer-cplusplus.*",
        "clang-analyzer-optin.*"
      ],
      "python": [
        "E722",
        "B006",
        "B008",
        "B904"
      ],
      "shell": [
        "SC2086",
        "SC2181",
        "SC2317"
      ]
    },
    "concurrency": {
      "kotlin": [
        "StaticFieldLeak",
        "HandlerLeak",
        "WrongThread",
        "BlockingMethodInNonBlockingContext"
      ],
      "java": [
        "StaticFieldLeak",
        "HandlerLeak",
        "WrongThread"
      ],
      "cpp": [
        "clang-analyzer-concurrency.*"
      ]
    },
    "performance": {
      "kotlin": [
        "DrawAllocation",
        "UseSparseArrays",
        "UseCompoundDrawables",
        "Overdraw"
      ],
      "java": [
        "DrawAllocation",
        "UseSparseArrays",
        "UseCompoundDrawables",
        "Overdraw"
      ],
      "cpp": [
        "performance-*",
        "readability-container-size-empty"
      ],
      "python": [
        "PERF*"
      ]
    },
    "security": {
      "kotlin": [
        "SetJavaScriptEnabled",
        "ExportedContentProvider",
        "ExportedReceiver",
        "ExportedService",
        "TrustAllX509TrustManager",
        "BadHostnameVerifier",
        "HardcodedDebugMode"
      ],
      "java": [
        "SetJavaScriptEnabled",
        "ExportedContentProvider",
        "ExportedReceiver",
        "ExportedService",
        "TrustAllX509TrustManager",
        "BadHostnameVerifier",
        "HardcodedDebugMode"
      ],
      "cpp": [
        "cert-*",
        "security-*"
      ],
      "python": [
        "S*"
      ],
      "shell": [
        "SC2086"
      ]
    }
  },
  "tools": {
    "kotlin": {
      "runner": "android-lint",
      "cwd": ".",
      "variant": "DevQa",
      "timeout": 1800,
      "source_roots": [
        "androidApp/src/main/",
        "androidApp/src/dev/",
        "androidApp/src/qa/",
        "androidApp/src/devQa/",
        "androidApp/src/test/",
        "androidApp/src/testDev/",
        "androidApp/src/testQa/",
        "androidApp/src/testDevQa/",
        "androidApp/src/androidTest/",
        "androidApp/src/androidTestDev/",
        "androidApp/src/androidTestQa/",
        "androidApp/src/androidTestDevQa/"
      ]
    },
    "cpp": {
      "runner": "clang-tidy",
      "timeout": 300,
      "database_globs": [
        "androidApp/.cxx/DevQa/*/arm64-v8a/compile_commands.json",
        "androidApp/.cxx/devQa/*/arm64-v8a/compile_commands.json",
        "androidApp/.cxx/Qa/*/arm64-v8a/compile_commands.json",
        "androidApp/.cxx/qa/*/arm64-v8a/compile_commands.json"
      ]
    },
    "java": {
      "runner": "android-lint",
      "cwd": ".",
      "variant": "DevQa",
      "timeout": 1800,
      "source_roots": [
        "androidApp/src/main/",
        "androidApp/src/dev/",
        "androidApp/src/qa/",
        "androidApp/src/devQa/",
        "androidApp/src/test/",
        "androidApp/src/testDev/",
        "androidApp/src/testQa/",
        "androidApp/src/testDevQa/",
        "androidApp/src/androidTest/",
        "androidApp/src/androidTestDev/",
        "androidApp/src/androidTestQa/",
        "androidApp/src/androidTestDevQa/"
      ]
    },
    "python": {
      "run": [
        "ruff",
        "check",
        "--output-format=json",
        "--no-cache",
        "--quiet",
        "."
      ],
      "parser": "ruff-json",
      "cwd": ".",
      "timeout": 900,
      "findings_exit_codes": [
        0,
        1
      ]
    },
    "shell": {
      "run": [
        "shellcheck",
        "--format=json1",
        "--severity=style"
      ],
      "parser": "shellcheck-json",
      "cwd": ".",
      "append_files": true,
      "timeout": 600,
      "findings_exit_codes": [
        0,
        1
      ]
    }
  },
  "notes": [
    "Curated diagnostic allowlists, not exhaustive proof of dead code or performance gains.",
    "Optimization hints require measurement; simplifications require behavior verification.",
    "Generated/vendored paths are protected. Android Lint covers configured app variant/source roots, not general unused public declarations. C++ uses only the selected compilation database/configuration; missing TU/header commands remain gaps.",
    "Gradle Kotlin DSL (.kts) is not analyzed. Python uses ruff, shell uses shellcheck; their remaining checks stay unclassified."
  ]
}
